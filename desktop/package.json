{
  "name": "neura-desktop",
  "productName": "Neura",
  "version": "1.1.0",
  "private": true,
  "description": "Neura para PC (Windows, macOS, Linux): chat multi-IA, hilos guardados en disco y puente MCP integrado",
  "author": "AngelazoGit (https://github.com/AngelazoGit)",
  "homepage": "https://github.com/AngelazoGit/neura",
  "license": "SEE LICENSE IN ../LICENSE",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.neura.desktop",
    "productName": "Neura",
    "artifactName": "Neura-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "app"
      },
      {
        "from": "../bridge",
        "to": "bridge",
        "filter": [
          "server.mjs",
          "package.json",
          "config.example.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Neura",
      "artifactName": "Neura-${version}-Windows-instalador.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "AngelazoGit"
    },
    "portable": {
      "artifactName": "Neura-${version}-Windows-portable.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AngelazoGit/neura.git"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
